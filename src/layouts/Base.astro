---
import { ClientRouter } from "astro:transitions";
import brFlag from "flag-icons/flags/4x3/br.svg?url";
import usFlag from "flag-icons/flags/4x3/us.svg?url";

import "../styles/global.css";
import { content, pathFor, profile, ui, type Lang, type PageKey } from "../lib/content";

interface Props {
  lang: Lang;
  page: PageKey;
  title?: string;
  description?: string;
  /** Caminho equivalente no outro idioma (padrão: a mesma página); é para onde a bandeira leva */
  alternate?: string;
  /** false quando a página não tem tradução (artigos): sem hreflang apontando para outra página */
  translated?: boolean;
  /** Imagem de compartilhamento (caminho do site ou URL completa) */
  image?: string;
  imageAlt?: string;
  /** Artigo: og:type article e data de publicação */
  published?: Date | null;
  noindex?: boolean;
  /** Dados estruturados extras desta página (schema.org), somados ao grafo do site */
  schema?: Record<string, unknown>[];
}

const { lang, page, title, description, alternate, translated = true, image, imageAlt, published, noindex, schema = [] } =
  Astro.props;
const other: Lang = lang === "pt" ? "en" : "pt";
const t = ui[lang];
const c = content(lang);
const otherPath = alternate ?? pathFor(other, page);
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${c.role}`;
const desc = description ?? (page === "home" ? c.headline : t.pageDesc[page as keyof typeof t.pageDesc]) ?? c.headline;
const site = Astro.site!;
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const canonical = new URL(withSlash(Astro.url.pathname), site).href;
const otherUrl = new URL(withSlash(otherPath), site).href;
const ptUrl = lang === "pt" ? canonical : otherUrl;
const locale = { pt: "pt_BR", en: "en_US" };
const hreflang = { pt: "pt-BR", en: "en" };
const ogImage = new URL(image ?? `/og/site-${lang}.png`, site).href;
const ogImageAlt = imageAlt ?? `${profile.name}, ${c.role}`;

// Grafo schema.org: o site, a pessoa (o autor de tudo) e esta página
const person = {
  "@type": "Person",
  "@id": `${site.origin}/#person`,
  name: profile.name,
  url: site.origin + "/",
  image: `${site.origin}/icon-512.png`,
  jobTitle: c.role,
  description: c.summary,
  email: `mailto:${profile.email}`,
  sameAs: [profile.github, profile.linkedin, profile.medium],
  knowsAbout: c.skillGroups.flatMap((group) => group.items).slice(0, 24),
  knowsLanguage: ["pt-BR", "en", "fr"],
};
const graph = [
  {
    "@type": "WebSite",
    "@id": `${site.origin}/#website`,
    url: site.origin + "/",
    name: profile.name,
    inLanguage: ["pt-BR", "en"],
    publisher: { "@id": person["@id"] },
  },
  person,
  {
    // Página de um projeto ou artigo (com schema próprio) é uma página comum; as listas são coleções
    "@type": page === "home" ? "ProfilePage" : schema.length === 0 && (page === "blog" || page === "projects") ? "CollectionPage" : "WebPage",
    "@id": canonical,
    url: canonical,
    name: fullTitle,
    description: desc,
    inLanguage: hreflang[lang],
    isPartOf: { "@id": `${site.origin}/#website` },
    primaryImageOfPage: ogImage,
    ...(page === "home" ? { mainEntity: { "@id": person["@id"] } } : { about: { "@id": person["@id"] } }),
  },
  ...schema,
];
const pages: PageKey[] = ["home", "projects", "blog", "experience", "contact"];
const socials = [
  { label: "GitHub", href: profile.github },
  { label: "LinkedIn", href: profile.linkedin },
  { label: "Medium", href: profile.medium },
];
---

<!doctype html>
<html lang={lang === "pt" ? "pt-BR" : "en"} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="theme-color" content="#060a18" />
    <link rel="canonical" href={canonical} />
    {
      translated && (
        <>
          <link rel="alternate" hreflang={hreflang[lang]} href={canonical} />
          <link rel="alternate" hreflang={hreflang[other]} href={otherUrl} />
          <link rel="alternate" hreflang="x-default" href={ptUrl} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content={published !== undefined ? "article" : page === "home" ? "profile" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale[lang]} />
    {translated && <meta property="og:locale:alternate" content={locale[other]} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {!image?.startsWith("http") && <meta property="og:image:width" content="1200" />}
    {!image?.startsWith("http") && <meta property="og:image:height" content="630" />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {published !== undefined && <meta property="article:author" content={profile.linkedin} />}
    {page === "home" && <meta property="profile:first_name" content="Diego" />}
    {page === "home" && <meta property="profile:last_name" content="Mirhan" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script is:inline>
      // Todas as animações rodam sempre, em qualquer dispositivo (decisão do projeto: inclusive com
      // "reduzir movimento" ligado no sistema)
      document.documentElement.classList.add("is-intro", "js-motion");
      // Recarregar mantém o dev mode ligado
      try {
        if (sessionStorage.getItem("dev") === "1") document.documentElement.classList.add("dev");
        if (localStorage.getItem("lite") === "1") document.documentElement.classList.add("is-lite");
      } catch {}
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
    />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <canvas id="scene" aria-hidden="true" transition:persist></canvas>
    <!-- Fundo 2D animado, só quando não há WebGL (aceleração de hardware desligada) -->
    <canvas id="scene-2d" aria-hidden="true" transition:persist></canvas>
    <div class="backdrop" aria-hidden="true" transition:persist="backdrop"></div>
    <!-- Dev mode: areia vermelha sobre o "subwoofer", no fundo de tudo (atrás da cena 3D) -->
    <canvas id="dev-sand" aria-hidden="true" transition:persist></canvas>
    <div class="scrim" aria-hidden="true" transition:persist="scrim"></div>
    <canvas id="smoke" aria-hidden="true" transition:persist></canvas>

    <!-- Dev mode: código flutuante e ondas na base (canvas), vinheta e grão -->
    <div class="dev-fx" aria-hidden="true" transition:persist="dev-fx">
      <canvas id="dev-layer"></canvas>
      <div class="dev-fx__vignette"></div>
      <div class="dev-fx__grain"></div>
    </div>

    <div id="preloader">
      <p class="mono" data-fade aria-hidden="true">{profile.name}</p>
      <p class="preloader__count display" data-fade aria-hidden="true"><span data-count>000</span><span class="accent">%</span></p>
      <div class="preloader__bar" data-fade aria-hidden="true"><span data-bar></span></div>
      <div class="preloader__enter" data-enter hidden>
        <div class="preloader__stage">
          <span class="preloader__halo" aria-hidden="true"></span>
          <button class="preloader__go mono" type="button" data-enter-sound data-magnetic="0.25">
            <span class="go__fill" aria-hidden="true"></span>
            <span class="go__label" data-text={t.enter}><span>{t.enter}</span></span>
            <span class="go__arrow" aria-hidden="true">→</span>
          </button>
        </div>
        <button class="preloader__silent mono" type="button" data-enter-silent>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 9h4l5-4v14l-5-4H4z" />
            <path d="M17 9l5 6M22 9l-5 6" />
          </svg>
          <span>{t.enterSilent}</span>
        </button>
      </div>
    </div>

    <header class="header">
      <a href={pathFor(lang, "home")} class="header__brand display" aria-label={profile.name}>
        Diego<span class="accent">.</span>
      </a>
      <!-- Só aparece com o menu aberto -->
      <button class="lite mono" type="button" data-lite-toggle aria-pressed="false">
        <span class="lite__track" aria-hidden="true"><span></span></span>
        {t.lite}
      </button>
      <div class="header__actions">
        <!-- Som do dev mode: no hover (ou foco) a pílula se abre para a esquerda com o volume -->
        <div class="sound-wrap">
          <label class="volume">
            <span class="sr-only">{t.volume}</span>
            <input type="range" min="0" max="100" step="1" value="100" data-dev-volume />
          </label>
          <button class="sound" type="button" data-dev-sound aria-pressed="false" aria-label={t.mute} title={t.mute} data-label-mute={t.mute} data-label-unmute={t.unmute}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 9h4l5-4v14l-5-4H4z" />
              <path class="sound__wave" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" />
              <path class="sound__off" d="M17 9l5 6M22 9l-5 6" />
            </svg>
          </button>
        </div>
        <button class="devbtn mono" type="button" data-dev-toggle aria-pressed="false" title={t.devMode}>
          <span class="devbtn__dot" aria-hidden="true"></span>dev mode
        </button>
        <a
          href={otherPath}
          class="flag"
          hreflang={other}
          lang={other}
          aria-label={t.switchLang}
          title={t.switchLang}
          data-magnetic="0.4"
        >
          <img src={other === "en" ? usFlag : brFlag} alt="" width="28" height="21" />
        </a>
        <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle data-magnetic="0.3">
          <span class="sr-only">{t.menu}</span>
          <span class="burger__line burger__line--top" aria-hidden="true"></span>
          <span class="burger__line burger__line--mid" aria-hidden="true"></span>
          <span class="burger__line burger__line--bottom" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <nav id="menu" class="menu" aria-label={t.menu} inert>
      <ul class="menu__list">
        {
          pages.map((key) => (
            <li class="menu__row">
              <a
                href={pathFor(lang, key)}
                class:list={["menu__link display", { "is-current": key === page }]}
                aria-current={key === page ? "page" : undefined}
              >
                <span class="menu__inner" data-menu-item>
                  {t.nav[key]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu__foot mono" data-menu-fade>
        <a href={`mailto:${profile.email}`} class="u-link">{profile.email}</a>
        <ul class="menu__socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noreferrer" class="u-link">
                  {s.label}
                </a>
              </li>
            ))
          }
          <li><a href={profile.resume[lang]} download class="u-link">{t.resume}</a></li>
        </ul>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer wrap">
      <div class="footer__row mono">
        <a href={`mailto:${profile.email}`} class="u-link">{profile.email}</a>
        <ul class="footer__socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noreferrer" class="u-link">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="muted">© {new Date().getFullYear()} {profile.name}. {t.rights}</p>
      </div>
      <p class="footer__mark display" aria-hidden="true" data-reveal>Diego Mirhan</p>
    </footer>

    <div id="preview" aria-hidden="true"><img alt="" /></div>
    <div id="curtain" aria-hidden="true" transition:persist></div>
    <canvas id="dev-bubble" aria-hidden="true" transition:persist></canvas>

    <!-- Barra de rolagem própria (desktop): ver scripts/scrollbar.ts -->
    <div id="scrollbar" aria-hidden="true" transition:persist><span class="scrollbar__thumb"></span></div>

    <script>
      import "../scripts/motion";
      import "../scripts/dev";
      import "../scripts/scrollbar";
      // Three.js em chunk separado: o conteúdo e as animações não esperam a cena 3D
      import("../scripts/scene");
    </script>
  </body>
</html>

<style is:global>
  /* A fumaça do cursor fica acima do escurecimento (senão some do lado esquerdo) e abaixo do texto.
   * Camadas fixas de fundo com a altura da tela sem a barra do navegador (100lvh): no celular a
   * barra aparece e some ao rolar, e a altura não pode mudar junto (a cena esticava e pulava). */
  #scene,
  #scene-2d,
  #smoke {
    position: fixed;
    inset: 0 0 auto;
    width: 100vw;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
  }

  /* Luz ambiente atrás da cena; também é o fundo quando não há WebGL */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(60vmax 50vmax at 85% 10%, oklch(0.44 0.19 262 / 32%), transparent 70%),
      radial-gradient(50vmax 45vmax at 5% 95%, oklch(0.54 0.11 232 / 22%), transparent 70%),
      var(--bg);
  }

  /* Escurece a faixa onde fica o texto, entre a cena e o conteúdo.
   * Desktop: lado esquerdo (as formas ficam à direita). Mobile: tela toda, mais leve. */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, oklch(0.1 0.016 262 / 72%) 0%, oklch(0.1 0.016 262 / 50%) 38%, transparent 52%);
  }

  @media (max-aspect-ratio: 1/1) {
    .scrim {
      background: oklch(0.1 0.016 262 / 45%);
    }
  }

  /* ---------- Preloader ---------- */
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: 1.25rem;
    padding: var(--gutter);
    background: var(--bg-deep);
    clip-path: inset(0 0 0 0);
  }

  .preloader__count {
    font-size: clamp(5rem, 22vw, 20rem);
    line-height: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .preloader__bar {
    height: 2px;
    background: var(--line);
  }

  .preloader__bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--cobalt-bright), var(--cerulean-bright));
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Sem JS não há quem tire o preloader */
  html:not(.is-intro) #preloader {
    display: none;
  }

  /* ---------- Header ---------- */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 70;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5rem;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  /* Faixa escura atrás do cabeçalho: o texto que rola por baixo não colide com logo e botões */
  .header::before {
    content: "";
    position: absolute;
    inset: 0 0 -2rem;
    z-index: -1;
    background: linear-gradient(to bottom, var(--bg) 62%, transparent);
    pointer-events: none;
  }

  .header > * {
    pointer-events: auto;
  }

  .header__brand {
    font-size: 1.75rem;
    line-height: 1;
    mix-blend-mode: difference;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Botão "dev mode": pílula ao lado da bandeira */
  .devbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    height: 3rem;
    padding-inline: 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in oklch, var(--bg) 55%, transparent);
    backdrop-filter: blur(12px);
    color: var(--fg);
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      border-color 0.3s,
      background-color 0.3s,
      color 0.3s;
  }

  .devbtn:hover {
    border-color: var(--fg);
  }

  .devbtn__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--muted);
    transition: background-color 0.3s, box-shadow 0.3s;
  }

  .devbtn[aria-pressed="true"] {
    border-color: var(--signal);
    background: oklch(0.63 0.24 25 / 16%);
  }

  .devbtn[aria-pressed="true"] .devbtn__dot {
    background: var(--signal);
    box-shadow: 0 0 0.6rem var(--signal);
    animation: devbtn-beat 5s infinite;
  }

  @keyframes devbtn-beat {
    0%, 12% { transform: scale(1); }
    2.5% { transform: scale(1.7); }
    7% { transform: scale(1.35); }
  }

  /* Mudo: só aparece no dev mode */
  /* Pílula do som: o botão redondo à direita e, escondido à esquerda, o volume. No hover ou
   * foco a pílula cresce para a esquerda; o seletor entra deslizando e a bolinha surge por último */
  .sound-wrap {
    display: none;
    align-items: center;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in oklch, var(--bg) 55%, transparent);
    backdrop-filter: blur(12px);
    transition:
      border-color 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .dev .sound-wrap {
    display: flex;
  }

  .sound {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 100%;
    border-radius: 50%;
    color: var(--fg);
  }

  .volume {
    display: flex;
    align-items: center;
    width: 0;
    height: 100%;
    overflow: hidden;
    opacity: 0;
    transform: translateX(0.75rem);
    transition:
      width 0.6s var(--ease-out),
      opacity 0.35s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .sound-wrap:hover,
  .sound-wrap:focus-within {
    border-color: color-mix(in oklch, var(--signal) 55%, transparent);
    box-shadow: 0 0 24px -6px color-mix(in oklch, var(--signal) 70%, transparent);
  }

  .sound-wrap:hover .volume,
  .sound-wrap:focus-within .volume {
    width: 7.5rem;
    opacity: 1;
    transform: none;
    transition:
      width 0.6s var(--ease-out),
      opacity 0.45s var(--ease-out) 0.1s,
      transform 0.6s var(--ease-out);
  }

  /* Seletor: trilho fino com o trecho ativo aceso (--v vem do JS) e bolinha com brilho */
  .volume input {
    --v: 100%;
    appearance: none;
    width: 6rem;
    height: 1.5rem;
    margin-left: 1.1rem;
    background: transparent;
    cursor: pointer;
  }

  .volume input::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--signal) var(--v), color-mix(in oklch, var(--fg) 22%, transparent) var(--v));
  }

  .volume input::-moz-range-track {
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--signal) var(--v), color-mix(in oklch, var(--fg) 22%, transparent) var(--v));
  }

  .volume input::-webkit-slider-thumb {
    appearance: none;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: calc(-0.4rem + 1px);
    border: 0;
    border-radius: 50%;
    background: var(--fg);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--signal) 35%, transparent), 0 0 14px var(--signal);
    transform: scale(0);
    transition: transform 0.35s var(--ease-out), box-shadow 0.3s;
  }

  .volume input::-moz-range-thumb {
    width: 0.8rem;
    height: 0.8rem;
    border: 0;
    border-radius: 50%;
    background: var(--fg);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--signal) 35%, transparent), 0 0 14px var(--signal);
    transform: scale(0);
    transition: transform 0.35s var(--ease-out), box-shadow 0.3s;
  }

  .sound-wrap:hover .volume input::-webkit-slider-thumb,
  .sound-wrap:focus-within .volume input::-webkit-slider-thumb {
    transform: scale(1);
    transition-delay: 0.25s;
  }

  .sound-wrap:hover .volume input::-moz-range-thumb,
  .sound-wrap:focus-within .volume input::-moz-range-thumb {
    transform: scale(1);
    transition-delay: 0.25s;
  }

  .volume input:active::-webkit-slider-thumb {
    transform: scale(1.25);
  }

  .volume input:active::-moz-range-thumb {
    transform: scale(1.25);
  }

  .volume input:focus-visible {
    outline: none;
  }

  .sound__off,
  .sound[aria-pressed="true"] .sound__wave {
    display: none;
  }

  .sound[aria-pressed="true"] .sound__off {
    display: inline;
  }

  @media (max-width: 560px) {
    .devbtn {
      height: 2.5rem;
      padding-inline: 0.8rem;
      font-size: 0.625rem;
    }

    .sound-wrap {
      height: 2.5rem;
    }

    .sound {
      width: 2.5rem;
    }

    .sound-wrap:hover .volume,
    .sound-wrap:focus-within .volume {
      width: 6rem;
    }

    .volume input {
      width: 4.8rem;
      margin-left: 0.9rem;
    }

    .header__actions {
      gap: 0.4rem;
    }
  }

