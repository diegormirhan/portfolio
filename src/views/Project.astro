---
import Base from "../layouts/Base.astro";
import DevNote from "../components/DevNote.astro";
import { projectPath, projects, ui, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = ui[lang];
const all = projects(lang);
const index = all.findIndex((p) => p.slug === slug);
const project = all[index]!;
const next = all[(index + 1) % all.length]!;
const repoUrl = `https://github.com/${project.repo}`;
---

<Base
  lang={lang}
  page="projects"
  title={project.title}
  description={project.description}
  alternate={projectPath(lang === "pt" ? "en" : "pt", slug)}
>
  <section class="wrap page-top head dev-host" data-intro data-scene="1" data-scene-x="2.3" data-scene-scale="0.75">
    <p class="mono muted" data-reveal>{project.year}</p>
    <h1 class="display display--xl" data-split="intro">{project.title}</h1>
    <p class="display display--sm accent" data-split="intro" data-delay="0.2">{project.tagline}</p>
    <div class="head__foot" data-reveal>
      <ul class="tags">{project.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
      <div class="actions">
        <a href={repoUrl} target="_blank" rel="noreferrer" class="pill" data-magnetic>{t.code} ↗</a>
        {
          project.demo && (
            <a href={project.demo} target="_blank" rel="noreferrer" class="pill pill--solid" data-magnetic>
              {t.demo} ↗
            </a>
          )
        }
      </div>
    </div>
    <DevNote text={project.dev} />
  </section>

  <figure class="shot wrap" data-clip>
    <img src={project.image} alt={project.imageAlt} data-parallax="0.6" />
  </figure>

  <section class="wrap section detail" data-scene="3" data-scene-y="-0.9" data-scene-dim="0.3">
    <p class="lead detail__intro" data-fill>{project.description}</p>
    <div class="detail__overview">
      {project.overview.map((paragraph) => <p data-lines>{paragraph}</p>)}
    </div>
    <ul class="detail__highlights">
      {
        project.highlights.map((item) => (
          <li class="highlight" data-reveal>
            <h2 class="display display--sm">{item.title}</h2>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
    <a href={repoUrl} target="_blank" rel="noreferrer" class="detail__docs mono u-link" data-reveal>
      {t.fullDocs} ↗
    </a>
  </section>

  <section class="wrap next" data-scene="0" data-scene-scale="0.9">
    <a href={projectPath(lang, next.slug)} class="next__link" data-preview data-preview-src={next.image}>
      <span class="mono muted">{t.next}</span>
      <span class="display display--xl" data-split>{next.title}</span>
    </a>
  </section>
</Base>

<style>
  .head {
    display: grid;
    gap: 1.25rem;
  }

  .head__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .tags,
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .shot {
    margin-top: clamp(3rem, 10vh, 6rem);
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 0;
    max-width: calc(1600px - var(--gutter) * 2);
    width: calc(100% - var(--gutter) * 2);
    aspect-ratio: 16 / 9;
  }

  .shot img {
    width: 100%;
    height: 116%;
    margin-top: -8%;
    object-fit: cover;
    object-position: top center;
  }

  .detail {
    display: grid;
    gap: clamp(3rem, 8vh, 5rem);
  }

  .detail__intro {
    max-width: 26ch;
  }

  /* Visão geral: coluna de leitura deslocada para a direita */
  .detail__overview {
    display: grid;
    gap: 1.25rem;
    max-width: 62ch;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    line-height: 1.65;
    color: oklch(0.96 0.006 250 / 88%);
  }

  @media (min-width: 900px) {
    .detail__overview {
      margin-left: 38%;
    }
  }

  /* Destaques: grade 2 × 2 separada por linhas, sem cards */
  .detail__highlights {
    display: grid;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .detail__highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 5rem);
    }
  }

  .highlight {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding-block: clamp(1.75rem, 4vh, 2.5rem);
    border-bottom: 1px solid var(--line);
  }

  .highlight p {
    max-width: 46ch;
    color: var(--muted);
    line-height: 1.6;
  }

  .detail__docs {
    justify-self: start;
    color: var(--cerulean-bright);
  }

  .next {
    padding-block: clamp(5rem, 14vh, 9rem);
  }

  .next__link {
    display: grid;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    transition: color 0.4s;
  }

  .next__link:hover {
    color: var(--cerulean-bright);
  }

</style>
